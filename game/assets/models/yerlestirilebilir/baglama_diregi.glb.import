[remap]

importer="scene"
importer_version=1
type="PackedScene"

[params]

meshes/ensure_tangents=true
meshes/generate_lods=true
meshes/create_shadow_meshes=true
gltf/embedded_image_handling=0
_subresources={
"materials": {
"kabarma_wood": {
"use_external/enabled": true,
"use_external/path": "res://assets/models/build/wood/wood_kit.tres",
"use_external/fallback_path": "res://assets/models/build/wood/wood_kit.tres"
}
}
}
