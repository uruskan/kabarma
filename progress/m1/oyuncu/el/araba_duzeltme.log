# pipeline/grip_markers.py -- el_arabasi (ilk kosu: duzeltme + isaretler; ikinci kosu: degismedi)
CARTFIX ok el_arabasi duzeltildi: body: once arkada yan -0.29 m, onde ust uclar yan +0.05 m; simdi arkada yan -0.29, +0.29 m, kova body -yan yarisindan aynalandi (8475 ucgen, dikiste 329 kose, 440 ucgen kesildi); delik yamalari: aynalanmis yama (ileri +0.15, yan -0.20, delik ~0.09 m, 205 ucgen, yuzeye oturan kose %82, iki yari farki -11.7..+7.4 mm); ozgun yama (ileri +0.15, yan +0.20, delik ~0.09 m, 186 ucgen, yuzeye oturan kose %82, iki yari farki -11.0..+7.4 mm); ileri uzunluk 1.081 -> 1.080 m
MARKER ok el_arabasi handle_l=(-0.483, +0.720, -0.327) handle_r=(-0.483, +0.720, +0.244) saplar yan -0.29 / +0.29 m; l: cap 3.8 cm egim 28d avucta capraz 26d yukseklik 0.720; r: cap 3.8 cm egim 28d avucta capraz 26d yukseklik 0.720
CARTFIX ok el_arabasi degismedi: body: arkada zaten simetrik iki sap (yan -0.29, +0.29 m); dokunulmadi

